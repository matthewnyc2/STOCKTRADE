# Environment variables for Crypto Quant Laboratory

# Database Configuration
DATABASE_URL=sqlite:///./data/crypto_quant.db
# For PostgreSQL/TimescaleDB:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/crypto_quant

# Database connection parameters (used when DATABASE_URL not set)
DB_USER=username
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_quant

# Security Configuration
API_KEY=your-secret-api-key-here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Optional: JWT Configuration (for future implementation)
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Optional: Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Optional: Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@cryptoquant.com