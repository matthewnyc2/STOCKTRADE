# STOCKTRADE Platform - Environment Variables Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to version control!

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false
TESTING=false
MAX_WORKERS=4
TIMEZONE=UTC

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///./data/crypto_quant.db

# PostgreSQL/TimescaleDB (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_PRE_PING=true
# DB_ECHO=false

# ============================================================================
# SECURITY SETTINGS (CRITICAL - MUST BE SET IN PRODUCTION)
# ============================================================================
# REQUIRED in production - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-min-32-characters-long-here-change-this

# Optional API key for middleware authentication
# API_KEY=your-api-key-here

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
PASSWORD_MIN_LENGTH=8

# ============================================================================
# API SETTINGS
# ============================================================================
API_TITLE=Crypto Quant Laboratory API
API_VERSION=1.0.0
API_DESCRIPTION=Cryptocurrency quantitative trading platform API
API_DOCS_ENABLED=true

# CORS Settings (comma-separated list, * for all origins)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# EXTERNAL API KEYS (Optional - free tiers may not require keys)
# ============================================================================
# CoinGecko (free tier doesn't require key)
COINGECKO_API_KEY=

# Binance API
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken API
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ============================================================================
# LOGGING SETTINGS
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_FILE=./logs/app.log  # Uncomment to enable file logging
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================
# Redis (for caching and sessions)
# REDIS_URL=redis://localhost:6379/0

# Email (for notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@cryptoquant.com