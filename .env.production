# Production Environment Configuration for Crypto Quant Laboratory
# Copy this file to .env and fill in your actual values

# =================================================================
# Database Configuration (TimescaleDB/PostgreSQL)
# =================================================================
DB_NAME=crypto_quant_prod
DB_USER=crypto_user
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql+asyncpg://crypto_user:your-secure-password-here@database:5432/crypto_quant_prod

# =================================================================
# Redis Configuration
# =================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your-redis-password-here

# =================================================================
# Security Configuration
# =================================================================
# API Key for external integrations
API_KEY=your-super-secret-api-key-here

# JWT Configuration (for future authentication)
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# =================================================================
# Application Configuration
# =================================================================
# Disable debug mode in production
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING

# Host and port binding
HOST=0.0.0.0
PORT=8000

# =================================================================
# Rate Limiting Configuration
# =================================================================
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Window size in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# =================================================================
# Monitoring and Observability
# =================================================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn-here

# Prometheus metrics directory
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# =================================================================
# Email Configuration (for notifications)
# =================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@cryptoquant.com

# =================================================================
# SSL/TLS Configuration (for HTTPS)
# =================================================================
# These should be referenced in nginx configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =================================================================
# Backup Configuration
# =================================================================
# Database backup schedule (cron format)
BACKUP_CRON_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Number of days to keep backups
BACKUP_RETENTION_DAYS=30

# =================================================================
# Feature Flags
# =================================================================
# Enable/disable specific features
ENABLE_WHALES_ALERTS=true
ENABLE_ARBITRAGE_ALERTS=true
ENABLE_GENETIC_ALGORITHM=true
ENABLE_ML_PREDICTIONS=false
ENABLE_REALTIME_DATA=true
ENABLE_DARK_POOL_MONITORING=true

# =================================================================
# Performance Configuration
# =================================================================
# WebSocket configuration
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_PING_INTERVAL=30

# Cache configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# =================================================================
# External API Keys
# =================================================================
# Binance API for market data
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key

# Coinbase API
COINBASE_API_KEY=your-coinbase-api-key
COINBASE_SECRET_KEY=your-coinbase-secret-key

# Other exchange APIs as needed...
# EXCHANGE2_API_KEY=your-api-key
# EXCHANGE2_SECRET_KEY=your-secret-key

# =================================================================
# AI/ML Configuration
# =================================================================
# Model configuration
MODEL_PATH=/app/models
MAX_PREDICTION_HORIZON=168  # hours

# Training configuration
RETRAIN_INTERVAL=24  # hours
TRAINING_DATA_POINTS=10000

# =================================================================
# Trading Configuration
# =================================================================
# Default position sizes
DEFAULT_POSITION_SIZE=0.01  # 1% of portfolio

# Risk management
MAX_DRAWDOWN=0.20  # 20% maximum drawdown
STOP_LOSS_PERCENTAGE=0.02  # 2% stop loss

# =================================================================
# Additional Configuration
# =================================================================
# Timezone setting
TZ=UTC

# Enable/disable specific loggers
LOGGING_LEVEL_SQLALCHEMY=WARNING
LOGGING_LEVEL_UVICORN=INFO
LOGGING_LEVEL_WEBSOCKET=WARNING

# Health check endpoints
HEALTH_CHECK_ENDPOINT=/
METRICS_ENDPOINT=/metrics